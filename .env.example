# Supabase project credentials.
# Both values are public by design (they ship in the browser bundle) — the data
# is protected by row level security, which only lets signed-in users through.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Gmail OAuth credentials belong ONLY in Supabase Edge Function secrets (or
# ignored supabase/.env.local for local serving), never in a VITE_* variable:
# GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, GOOGLE_OAUTH_REDIRECT_URI,
# GMAIL_TOKEN_ENCRYPTION_KEY, GMAIL_APP_ORIGIN, GMAIL_APP_BASE_PATH.
# See README.md for callback and key configuration. Do not put real secrets here.

# Supabase project credentials.
# Both values are public by design (they ship in the browser bundle) — the data
# is protected by row level security, which only lets signed-in users through.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Gmail OAuth credentials belong ONLY in Supabase Edge Function secrets (or an
# ignored supabase/.env.local while serving functions locally), never in a
# VITE_* variable. Do not put real values in this file.
#
# GOOGLE_OAUTH_CLIENT_ID=<Google Web application client ID>
# GOOGLE_OAUTH_CLIENT_SECRET=<Google Web application client secret>
# GOOGLE_OAUTH_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/gmail-callback
# GMAIL_TOKEN_ENCRYPTION_KEY=<base64 of exactly 32 random bytes>
# GMAIL_APP_ORIGIN=https://<app-origin-without-a-trailing-slash>
# GMAIL_APP_BASE_PATH=/invoice-app
# GMAIL_CRON_SECRET=<at least 32 random characters; also store as Vault gmail_cron_secret>
#
# The database schedules also need these Supabase Vault secrets. They are not
# Edge Function environment variables:
# gmail_project_url=https://<project-ref>.supabase.co
# gmail_cron_secret=<same value as GMAIL_CRON_SECRET>
# tax_export_project_url=https://<project-ref>.supabase.co
# tax_export_service_role_key=<project legacy service-role JWT>
#
# Full rollout instructions: docs/finance-dashboard-operations.md.
